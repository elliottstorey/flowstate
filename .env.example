# Database connection string used by the app and DB tooling
DATABASE_URL=
# Postgres user for the local Docker database (see .framework/db/compose.yml)
POSTGRES_USER=
# Postgres password for the local Docker database (see .framework/db/compose.yml)
POSTGRES_PASSWORD=
# Google OAuth client ID for sign-in
GOOGLE_CLIENT_ID=
# Google OAuth client secret for sign-in
GOOGLE_CLIENT_SECRET=
# Stripe secret key for subscriptions and webhooks
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for verifying webhook events
STRIPE_WEBHOOK_SECRET=
# Stripe price ID for the monthly subscription product
STRIPE_PRICE_ID=
# OpenRouter API key for LLM access
OPENROUTER_API_KEY=
# LLM model in provider/model form, e.g. openrouter/model-id
MODEL=
# Runtime environment (development, production)
NODE_ENV=
